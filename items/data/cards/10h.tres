value = 6.0

[sub_resource type="Resource" id="Effect"]
script = ExtResource("3_effect")

[resource]
script = ExtResource("1_card")
suit = 0
rank = 10
title = "Second Wind"
description = "Once per level, a lethal hit leaves you at 1 HP with 1.5 s invulnerability."
