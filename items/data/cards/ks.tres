[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://items/card_data.gd" id="1_card"]
[ext_resource type="Script" path="res://items/card_stat.gd" id="2_stat"]
[ext_resource type="Script" path="res://items/effects/ghostwalk_effect.gd" id="3_effect"]

[sub_resource type="Resource" id="Stat_0"]
script = ExtResource("2_stat")
stat = &"move_speed"
value = 0.4

[sub_resource type="Resource" id="Stat_1"]
script = ExtResource("2_stat")
stat = &"ability_haste"
value = 10.0

[sub_resource type="Resource" id="Effect"]
script = ExtResource("3_effect")

[resource]
script = ExtResource("1_card")
suit = 3
rank = 13
title = "Ghostwalk"
description = "During active speed boosts (abilities, Aces), walk through walls."
stats = Array[ExtResource("2_stat")]([SubResource("Stat_0"), SubResource("Stat_1")])
effect = SubResource("Effect")
