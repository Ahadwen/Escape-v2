[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://director/threat_profile.gd" id="1_profile"]
[ext_resource type="Script" path="res://director/spawn_entry.gd" id="2_entry"]
[ext_resource type="Resource" path="res://enemies/data/chaser.tres" id="3_chaser"]
[ext_resource type="Resource" path="res://enemies/data/charger.tres" id="4_charger"]

[sub_resource type="Resource" id="Resource_chaser"]
script = ExtResource("2_entry")
