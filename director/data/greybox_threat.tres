spawn_distance_max = 30.0
ahead_bias = 0.65
entries = Array[ExtResource("2_entry")]([SubResource("Resource_chaser"), SubResource("Resource_charger"), SubResource("Resource_spinner"), SubResource("Resource_gunner"), SubResource("Resource_artillery"), SubResource("Resource_laser"), SubResource("Resource_brood")])
